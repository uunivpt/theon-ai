# Server-only secrets — NEVER prefix these with NEXT_PUBLIC_
AICREDITS_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
TWELVE_DATA_API_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_NUMBER=

# Distributed abuse protection (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DISTRIBUTED_RATE_LIMIT=true

# Strong client-attestation mode. Enable after App Check is configured.
FIREBASE_APPCHECK_ENFORCE=false
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_APP_ORIGIN=https://theonai.online

# Keep local fallback disabled in production.
ALLOW_LOCAL_RATE_LIMIT_FALLBACK=false
